# Every variable the app, the build and the pipeline read. No values for secrets here:
# locally they come from 1Password through .env.op, in CI from GitHub Actions secrets.
# Never create a plaintext .env or .env.local (see README, «Secretos»).

# Secrets (GitHub Actions secrets in CI)
ANTHROPIC_API_KEY=
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
TRAP_SECRET=

# Pipeline settings (GitHub Actions variables in CI)
ANTHROPIC_MODEL=claude-sonnet-5-5
MONTHLY_BUDGET_USD=20
MAX_FESTIVALS_PER_RUN=40

# Build settings. deploy.yml sets them for GitHub Pages: BASE_PATH=/<repo>/,
# SITE_URL=https://<owner>.github.io/<repo>/, VITE_REPO=<owner>/<repo>.
SITE_URL=http://localhost:4173/
BASE_PATH=/
# owner/repo where «Reportar un error» and «Reportar contenido» open issues (RF-17).
VITE_REPO=

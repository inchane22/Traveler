# 1Password reference template (committed, holds no values).
# Use: op run --env-file=.env.op -- pnpm refresh -- --dry-run
# Every field below must exist in vault Dev, item "traveler", or op run fails
# (ARCHIVE_* are optional for the pipeline, but the fields still have to exist).
ANTHROPIC_API_KEY=op://Dev/traveler/ANTHROPIC_API_KEY
ARCHIVE_ACCESS_KEY=op://Dev/traveler/ARCHIVE_ACCESS_KEY
ARCHIVE_SECRET_KEY=op://Dev/traveler/ARCHIVE_SECRET_KEY

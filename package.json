{
  "name": "traveler",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Calendario anual de las fiestas con más gente y más calle, por país, con verificación semanal por IA.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "INCLUDE_DRAFTS=1 pnpm run data && vite",
    "data": "node scripts/build-data.ts && node scripts/build-calendars.ts",
    "build": "pnpm run data && vite build && node scripts/check-csp.ts && node scripts/check-secrets.ts",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "lhci": "lhci autorun",
    "check-secrets": "node scripts/check-secrets.ts",
    "refresh": "node scripts/refresh.ts",
    "onboard": "node scripts/onboard.ts",
    "validate-data": "node scripts/build-data.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/anybody": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
